{
  "name": "my-desktop",
  "version": "1.8.0",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/start-standalone.cjs",
    "desktop:dev": "concurrently -k \"next dev -p 3000\" \"wait-on http://localhost:3000 && electron .\"",
    "desktop:dir": "bun run build && electron-builder --dir --publish never",
    "desktop:dist": "bun run build && electron-builder --publish never",
    "desktop:dist:win": "bun run build && bun run desktop:pack:win",
    "desktop:dist:linux": "bun run build && bun run desktop:pack:linux",
    "desktop:dist:mac": "bun run build && bun run desktop:pack:mac",
    "typecheck": "tsc --noEmit",
    "lint": "bunx @biomejs/biome@2.6.8 lint src electron tests",
    "format": "bunx @biomejs/biome@2.6.8 format --write .",
    "format:check": "bunx @biomejs/biome@2.6.8 ci --formatter-enabled=true --linter-enabled=false --assist-enabled=false electron/workspace-store.cjs electron/security.cjs src/shared/lib/date.ts",
    "test:integration": "bun test tests/integration",
    "test:component": "bun test tests/components",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov tests/unit tests/integration tests/components",
    "test:e2e": "playwright test",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run test:unit && bun run test:integration && bun run test:component",
    "desktop:pack:win": "electron-builder --win nsis --publish never",
    "desktop:pack:linux": "electron-builder --linux AppImage --publish never",
    "desktop:pack:mac": "electron-builder --mac dmg --publish never",
    "test:unit": "bun test tests/unit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "^5.7.2",
    "wait-on": "^8.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.0",
    "jsdom": "26.1.0"
  },
  "build": {
    "appId": "com.mydesktop.app",
    "productName": "my desktop",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "app-server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": ".next/static",
        "to": "app-server/.next/static",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "public",
        "to": "app-server/public",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "my-desktop-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "my desktop"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "icon": "assets/icon.png"
    }
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "description": "Личное desktop-приложение для управления профилем, проектами и задачами с хранением данных в JSON-файле",
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@reduxjs/toolkit": "^2.8.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "15.5.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0"
  }
}
