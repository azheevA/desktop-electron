{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": ["src/**", "electron/**", "tests/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "none",
      "suspicious": {
        "noDoubleEquals": "error",
        "noDebugger": "error"
      },
      "correctness": {
        "noUnreachable": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
